# ============================================
# WEB PANEL - ENVIRONMENT CONFIGURATION
# ============================================

# --------------------------------------------
# API CONFIGURATION
# --------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_URL=https://your-domain.com/api (for production)

# --------------------------------------------
# APP CONFIGURATION
# --------------------------------------------
NEXT_PUBLIC_APP_NAME=WhatsApp Store Bot
NEXT_PUBLIC_APP_VERSION=1.0.0

# --------------------------------------------
# OPTIONAL: ANALYTICS
# --------------------------------------------
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# --------------------------------------------
# OPTIONAL: FEATURE FLAGS
# --------------------------------------------
NEXT_PUBLIC_ENABLE_REGISTRATION=false
NEXT_PUBLIC_MAX_BOTS_PER_USER=5
